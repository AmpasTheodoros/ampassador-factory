# Names only. Never commit values. Full table with secrecy and purpose: docs/deployment.md

# --- production (required) ---
DATABASE_URL=                      # Supabase transaction pooler, role aaf_app (NOT the owner, NOT service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AAF_APP_ORIGIN=                    # https://your-domain

# --- development only (embedded database + local auth; forbidden in production) ---
AAF_DATA_DIR=.data/pglite          # ":memory:" for throwaway
AAF_DEV_EMAIL=
AAF_DEV_PASSWORD=                  # min 8 chars

# --- optional ---
AAF_OWNER_NAME=Theodoros
DATABASE_POOL_MAX=3
DATABASE_LEDGER_POOL_MAX=2           # dedicated pool for write-ahead ledger transactions (budget, execution records)
AI_GATEWAY_API_KEY=
AAF_AI_MODEL_CLASSIFY=             # AI Gateway "provider/model" string; none hardcoded
AAF_AI_MODEL_DRAFT=
AAF_AI_PRICE_IN_PER_M=             # EUR per million tokens
AAF_AI_PRICE_OUT_PER_M=
AAF_LLM_BASE_URL=                  # any OpenAI-compatible endpoint (e.g. a local server)
AAF_LLM_MODEL=
AAF_LLM_API_KEY=
AAF_LLM_LOCATION=cloud             # cloud | local
NETWORKRADAR_MCP_URL=
NETWORKRADAR_MCP_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
AAF_JOB_DRIVER=local               # local | trigger
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
AAF_TRIAGE_MODE=job                # job | inline
AAF_CRON_SECRET=

# --- migrations only: run from your machine / a migration-only CI secret, NEVER in the app's environment ---
# DATABASE_ADMIN_URL=

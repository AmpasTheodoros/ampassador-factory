diff --git a/src/lib/mcp/read-only.ts b/src/lib/mcp/read-only.ts
new file mode 100644
index 0000000..f162f47
--- /dev/null
+++ b/src/lib/mcp/read-only.ts
@@ -0,0 +1,34 @@
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+
+import { READ_ONLY_TOOL_ALLOWLIST } from "@/lib/mcp/scopes";
+
+/**
+ * A view of the server that can only register the allowlisted read tools.
+ *
+ * Every other tool is dropped at registration, so it does not exist on a read-only server: it is not listed and the
+ * SDK itself answers "not found" if it is called. An allowlisted tool must ALSO carry `readOnlyHint: true`; if it ever
+ * loses that annotation, building the server throws (the endpoint fails closed) rather than quietly exposing it.
+ * Resources and prompts are not exposed at all.
+ */
+export function restrictToReadOnly(server: McpServer, onDropped?: (name: string) => void): McpServer {
+  const noop = () => undefined;
+  return new Proxy(server, {
+    get(target, prop) {
+      if (prop === "registerTool") {
+        return (name: string, config: { annotations?: { readOnlyHint?: boolean } }, handler: unknown) => {
+          if (!READ_ONLY_TOOL_ALLOWLIST.has(name)) {
+            onDropped?.(name);
+            return undefined;
+          }
+          if (config?.annotations?.readOnlyHint !== true) {
+            throw new Error(`"${name}" is on the read-only allowlist but is not annotated readOnlyHint: refusing to expose it`);
+          }
+          return (target.registerTool as (...a: unknown[]) => unknown).call(target, name, config, handler);
+        };
+      }
+      if (prop === "registerResource" || prop === "registerPrompt" || prop === "resource" || prop === "prompt" || prop === "tool") return noop;
+      const v = Reflect.get(target, prop, target);
+      return typeof v === "function" ? v.bind(target) : v;
+    },
+  });
+}
diff --git a/src/lib/mcp/scopes.ts b/src/lib/mcp/scopes.ts
new file mode 100644
index 0000000..8a05432
--- /dev/null
+++ b/src/lib/mcp/scopes.ts
@@ -0,0 +1,120 @@
+import { createHash, timingSafeEqual } from "node:crypto";
+
+/**
+ * Credential scopes for the remote MCP endpoint.
+ *
+ *   full  every tool the account may use (OAuth, MCP_API_KEY, stdio): unchanged behaviour.
+ *   read  a separate credential that can call ONLY the tools named in READ_ONLY_TOOL_ALLOWLIST.
+ *
+ * The allowlist is an exact list of names. There is no wildcard and no "everything annotated readOnlyHint":
+ * adding a tool to what a machine client may call is a code change that shows up in review.
+ */
+export type McpScope = "full" | "read";
+
+export const READ_ONLY_TOOL_ALLOWLIST: ReadonlySet<string> = new Set([
+  "search_people",
+  "get_person",
+  "get_relationship_brief",
+  "list_actions",
+  "get_network_summary",
+]);
+
+/** JSON-RPC methods a read-only credential may use. Everything else (resources, prompts, completions, logging...) is refused. */
+export const READ_ONLY_METHOD_ALLOWLIST: ReadonlySet<string> = new Set([
+  "initialize",
+  "notifications/initialized",
+  "notifications/cancelled",
+  "ping",
+  "tools/list",
+  "tools/call",
+]);
+
+export const READONLY_KEY_PREFIX = "nrro_";
+/** nrro_ + 43 url-safe chars (32 random bytes) is what `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` produces. */
+const MIN_KEY_LENGTH = 40;
+
+export interface ReadonlyKeyEntry {
+  /** Short label used in logs. Never the key. */
+  id: string;
+  /** sha256(key) as hex. The key itself is never stored server-side. */
+  hash: string;
+  expiresAt: Date | null;
+}
+
+export const hashKey = (key: string): string => createHash("sha256").update(key).digest("hex");
+
+/**
+ * MCP_READONLY_KEYS = "id:sha256hex[:expiresISO],id2:sha256hex..."  (comma or newline separated)
+ *
+ * Rotation: put the new entry next to the old one, move clients, then delete the old entry.
+ * Revocation: delete the entry, or list its id in MCP_READONLY_REVOKED (takes effect on the next request, no redeploy of code).
+ * Malformed entries are ignored and reported through `onInvalid`; they never widen access.
+ */
+export function parseReadonlyKeys(raw: string | undefined, onInvalid?: (entry: string) => void): ReadonlyKeyEntry[] {
+  if (!raw) return [];
+  const out: ReadonlyKeyEntry[] = [];
+  for (const part of raw.split(/[,\n]/).map((s) => s.trim()).filter(Boolean)) {
+    // split on the FIRST TWO colons only: an ISO expiry ("2099-01-01T00:00:00Z") contains colons itself
+    const i1 = part.indexOf(":");
+    const i2 = i1 < 0 ? -1 : part.indexOf(":", i1 + 1);
+    const id = i1 < 0 ? part : part.slice(0, i1);
+    const hash = i1 < 0 ? undefined : part.slice(i1 + 1, i2 < 0 ? undefined : i2);
+    const expires = i2 < 0 ? undefined : part.slice(i2 + 1);
+    const exp = expires ? new Date(expires) : null;
+    const ok =
+      !!id && /^[a-z0-9_-]{1,32}$/.test(id) &&
+      !!hash && /^[0-9a-f]{64}$/.test(hash) &&
+      (exp === null || !Number.isNaN(exp.getTime()));
+    if (!ok) {
+      onInvalid?.(id ? `${id}:…` : "(empty id)");
+      continue;
+    }
+    out.push({ id: id!, hash: hash!, expiresAt: exp });
+  }
+  return out;
+}
+
+export type ReadonlyKeyResult =
+  | { ok: true; id: string }
+  | { ok: false; reason: "format" | "no_match" | "revoked" | "expired" };
+
+export function matchReadonlyKey(
+  token: string,
+  env: Record<string, string | undefined> = process.env,
+  now: Date = new Date(),
+): ReadonlyKeyResult {
+  if (!token.startsWith(READONLY_KEY_PREFIX) || token.length < MIN_KEY_LENGTH) return { ok: false, reason: "format" };
+  const presented = Buffer.from(hashKey(token), "hex");
+  const entries = parseReadonlyKeys(env.MCP_READONLY_KEYS);
+  const revoked = new Set((env.MCP_READONLY_REVOKED ?? "").split(",").map((s) => s.trim()).filter(Boolean));
+
+  // compare against every entry (no early exit) so timing does not reveal which entry matched
+  let matched: ReadonlyKeyEntry | null = null;
+  for (const e of entries) {
+    if (timingSafeEqual(presented, Buffer.from(e.hash, "hex")) && matched === null) matched = e;
+  }
+  if (!matched) return { ok: false, reason: "no_match" };
+  if (revoked.has(matched.id)) return { ok: false, reason: "revoked" };
+  if (matched.expiresAt && matched.expiresAt.getTime() <= now.getTime()) return { ok: false, reason: "expired" };
+  return { ok: true, id: matched.id };
+}
+
+export type RpcVerdict = { allowed: true } | { allowed: false; kind: "method" | "tool" | "shape"; value: string; id: unknown };
+
+/** Checks every JSON-RPC message in a request body against the read-only allowlists. One bad message refuses the whole request. */
+export function gateReadOnlyRpc(body: unknown): RpcVerdict {
+  const messages = Array.isArray(body) ? body : [body];
+  if (messages.length === 0) return { allowed: false, kind: "shape", value: "empty batch", id: null };
+  for (const m of messages) {
+    if (!m || typeof m !== "object") return { allowed: false, kind: "shape", value: "not an object", id: null };
+    const msg = m as { method?: unknown; params?: { name?: unknown }; id?: unknown };
+    if (typeof msg.method !== "string") return { allowed: false, kind: "shape", value: "no method", id: msg.id ?? null };
+    if (!READ_ONLY_METHOD_ALLOWLIST.has(msg.method)) return { allowed: false, kind: "method", value: msg.method, id: msg.id ?? null };
+    if (msg.method === "tools/call") {
+      const name = msg.params?.name;
+      if (typeof name !== "string" || !READ_ONLY_TOOL_ALLOWLIST.has(name))
+        return { allowed: false, kind: "tool", value: typeof name === "string" ? name : "(missing)", id: msg.id ?? null };
+    }
+  }
+  return { allowed: true };
+}

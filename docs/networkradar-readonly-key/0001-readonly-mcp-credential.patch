+++ b/tests/mcp-readonly.test.ts
@@ -0,0 +1,235 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createHash } from "node:crypto";
+
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+
+import { setMcpAuditSink } from "@/lib/mcp/audit";
+import { resolveMcpAuth } from "@/lib/mcp/auth";
+import { handleMcpHttpRequest } from "@/lib/mcp/http";
+import { restrictToReadOnly } from "@/lib/mcp/read-only";
+import {
+  READ_ONLY_TOOL_ALLOWLIST,
+  gateReadOnlyRpc,
+  hashKey,
+  matchReadonlyKey,
+  parseReadonlyKeys,
+} from "@/lib/mcp/scopes";
+import { registerTools } from "@/lib/mcp/tools";
+
+/**
+ * The read-only MCP credential. None of these tests call a handler that touches the database:
+ * they read registrations, and send real MCP requests through handleMcpHttpRequest for tools/list and for REFUSED calls.
+ */
+
+const KEY = "nrro_" + "A".repeat(43);
+const KEY2 = "nrro_" + "B".repeat(43);
+const FULL = "full-access-api-key-for-tests";
+const sha = (s: string) => createHash("sha256").update(s).digest("hex");
+
+const saved = { ...process.env };
+let audit: Record<string, unknown>[] = [];
+
+beforeEach(() => {
+  audit = [];
+  setMcpAuditSink((line) => audit.push(JSON.parse(line)));
+  process.env.MCP_OWNER_ID = "owner_test";
+  process.env.MCP_API_KEY = FULL;
+  process.env.MCP_READONLY_KEYS = `ci:${sha(KEY)}`;
+  delete process.env.MCP_READONLY_REVOKED;
+  Object.assign(process.env, { NODE_ENV: "production" });
+});
+afterEach(() => {
+  setMcpAuditSink(null);
+  for (const k of Object.keys(process.env)) if (!(k in saved)) delete process.env[k];
+  Object.assign(process.env, saved);
+});
+
+const post = (token: string | null, body: unknown, method = "POST") =>
+  new Request("http://localhost/mcp", {
+    method,
+    headers: {
+      "content-type": "application/json",
+      accept: "application/json, text/event-stream",
+      ...(token ? { authorization: `Bearer ${token}` } : {}),
+    },
+    body: method === "POST" ? JSON.stringify(body) : undefined,
+  });
+
+const rpc = (method: string, params: unknown = {}, id: number | null = 1) => ({ jsonrpc: "2.0", id, method, params });
+const init = rpc("initialize", { protocolVersion: "2025-03-26", capabilities: {}, clientInfo: { name: "t", version: "0" } });
+
+async function sseJson(res: Response): Promise<any> {
+  const text = await res.text();
+  const data = text.split("\n").find((l) => l.startsWith("data:"));
+  return JSON.parse(data ? data.slice(5).trim() : text);
+}
+
+describe("read-only key parsing and matching", () => {
+  it("accepts id:sha256hex[:expiry], rejects malformed entries without widening access", () => {
+    const bad: string[] = [];
+    const entries = parseReadonlyKeys(`ci:${sha(KEY)},BAD ID:${sha(KEY)},x:nothex,y:${sha(KEY)}:not-a-date,z:${sha(KEY)}:2099-01-01T00:00:00Z:extra,ok2:${sha(KEY2)}:2099-01-01T00:00:00Z`, (e) => bad.push(e));
+    expect(entries.map((e) => e.id)).toEqual(["ci", "ok2"]);
+    expect(bad).toHaveLength(4);
+  });
+  it("only the hash is stored: the plaintext key is never needed server-side", () => {
+    expect(matchReadonlyKey(KEY, { MCP_READONLY_KEYS: `ci:${hashKey(KEY)}` })).toEqual({ ok: true, id: "ci" });
+    expect(JSON.stringify(parseReadonlyKeys(`ci:${hashKey(KEY)}`))).not.toContain(KEY);
+  });
+  it("wrong, short, wrongly-prefixed, revoked and expired keys are all refused", () => {
+    const env = { MCP_READONLY_KEYS: `ci:${sha(KEY)},old:${sha(KEY2)}:2020-01-01T00:00:00Z` };
+    expect(matchReadonlyKey("nrro_" + "C".repeat(43), env)).toEqual({ ok: false, reason: "no_match" });
+    expect(matchReadonlyKey("nrro_short", env)).toEqual({ ok: false, reason: "format" });
+    expect(matchReadonlyKey("Bearer-ish-" + "A".repeat(40), env)).toEqual({ ok: false, reason: "format" });
+    expect(matchReadonlyKey(KEY2, env)).toEqual({ ok: false, reason: "expired" });
+    expect(matchReadonlyKey(KEY, { ...env, MCP_READONLY_REVOKED: "ci" })).toEqual({ ok: false, reason: "revoked" });
+    expect(matchReadonlyKey(KEY, {})).toEqual({ ok: false, reason: "no_match" });
+  });
+  it("rotation: old and new keys work side by side; deleting an entry revokes it", () => {
+    const both = { MCP_READONLY_KEYS: `a:${sha(KEY)},b:${sha(KEY2)}` };
+    expect(matchReadonlyKey(KEY, both)).toMatchObject({ ok: true, id: "a" });
+    expect(matchReadonlyKey(KEY2, both)).toMatchObject({ ok: true, id: "b" });
+    expect(matchReadonlyKey(KEY, { MCP_READONLY_KEYS: `b:${sha(KEY2)}` })).toEqual({ ok: false, reason: "no_match" });
+  });
+});
+
+describe("authentication paths", () => {
+  it("existing credentials are unchanged: the full API key still resolves to scope full", async () => {
+    const r = await resolveMcpAuth(post(FULL, init));
+    expect(r).toMatchObject({ ok: true, method: "api_key", scope: "full", ownerId: "owner_test" });
+  });
+  it("a valid read-only key resolves to scope read for the same owner, and reports its id", async () => {
+    const r = await resolveMcpAuth(post(KEY, init));
+    expect(r).toMatchObject({ ok: true, method: "readonly_key", scope: "read", ownerId: "owner_test", keyId: "ci" });
+  });
+  it("unknown, revoked and expired read-only keys get 401 and are audited without the key", async () => {
+    for (const [tok, env] of [
+      ["nrro_" + "Z".repeat(43), {}],
+      [KEY, { MCP_READONLY_REVOKED: "ci" }],
+      [KEY, { MCP_READONLY_KEYS: `ci:${sha(KEY)}:2000-01-01T00:00:00Z` }],
+    ] as const) {
+      process.env.MCP_READONLY_KEYS = `ci:${sha(KEY)}`; // each case starts from the baseline configuration
+      delete process.env.MCP_READONLY_REVOKED;
+      Object.assign(process.env, env);
+      const r = await resolveMcpAuth(post(tok, init));
+      expect(r.ok).toBe(false);
+      if (!r.ok) expect(r.response.status).toBe(401);
+    }
+    expect(audit.map((a) => a.reason)).toEqual(["invalid_key", "revoked_key", "expired_key"]);
+    expect(JSON.stringify(audit)).not.toContain("ZZZZ");
+    expect(JSON.stringify(audit)).not.toContain(KEY);
+  });
+  it("a read-only-looking token never falls through to the development fallback", async () => {
+    delete process.env.MCP_API_KEY;
+    Object.assign(process.env, { NODE_ENV: "development" });
+    const r = await resolveMcpAuth(post("nrro_" + "Q".repeat(43), init));
+    expect(r.ok).toBe(false);
+  });
+  it("the read-only key is NOT accepted where the full key is the only thing configured", async () => {
+    delete process.env.MCP_READONLY_KEYS;
+    const r = await resolveMcpAuth(post(KEY, init));
+    expect(r.ok).toBe(false);
+  });
+});

+describe("what a read-only server exposes", () => {
+  function collect(restricted: boolean) {
+    const names: string[] = [];
+    const dropped: string[] = [];
+    const base = {
+      registerTool(name: string, _c: unknown, _h: unknown) {
+        names.push(name);
+      },
+    } as unknown as McpServer;
+    process.env.MCP_OWNER_ID = "owner_test";
+    registerTools(restricted ? restrictToReadOnly(base, (n) => dropped.push(n)) : base, "owner_test");
+    return { names, dropped };
+  }
+
+  it("registers exactly the five allowlisted tools; everything else is dropped (and counted)", () => {
+    const full = collect(false);
+    const ro = collect(true);
+    expect([...ro.names].sort()).toEqual([...READ_ONLY_TOOL_ALLOWLIST].sort());
+    expect(ro.dropped.length).toBe(full.names.length - READ_ONLY_TOOL_ALLOWLIST.size);
+    for (const bad of ["send_email", "send_approved_smtp_email", "create_person", "set_relationship_objective", "approve_chief_reply", "create_gmail_draft", "social_publish", "forget_about_person"]) {
+      expect(ro.names).not.toContain(bad);
+      expect(full.names, `${bad} should exist on the full surface (otherwise this test proves nothing)`).toContain(bad);
+    }
+  });
+  it("contract drift guard: every allowlisted name still exists on the full surface", () => {
+    const full = collect(false).names;
+    for (const n of READ_ONLY_TOOL_ALLOWLIST) expect(full).toContain(n);
+  });
+  it("an allowlisted tool that loses its readOnlyHint makes the read-only server FAIL to build, not expose it", () => {
+    const base = { registerTool() {} } as unknown as McpServer;
+    const r = restrictToReadOnly(base);
+    expect(() => r.registerTool("search_people", { annotations: {} } as never, (() => {}) as never)).toThrow(/readOnlyHint/);
+    expect(() => r.registerTool("send_email", { annotations: {} } as never, (() => {}) as never)).not.toThrow(); // dropped silently
+  });
+  it("resources and prompts are not registered on a read-only server", () => {
+    let calls = 0;
+    const base = { registerResource: () => calls++, registerPrompt: () => calls++, resource: () => calls++, prompt: () => calls++, tool: () => calls++ } as unknown as McpServer;
+    const r = restrictToReadOnly(base);
+    (r as any).registerResource("x"); (r as any).registerPrompt("x"); (r as any).resource("x"); (r as any).prompt("x"); (r as any).tool("x");
+    expect(calls).toBe(0);
+  });
+});
+
+describe("request gate (runs before any handler exists)", () => {
+  it("allows initialize, tools/list, tools/call of allowlisted tools, and notifications; refuses everything else", () => {
+    expect(gateReadOnlyRpc(init).allowed).toBe(true);
+    expect(gateReadOnlyRpc(rpc("tools/list")).allowed).toBe(true);
+    expect(gateReadOnlyRpc(rpc("tools/call", { name: "get_person", arguments: { personId: "x" } })).allowed).toBe(true);
+    expect(gateReadOnlyRpc({ jsonrpc: "2.0", method: "notifications/initialized" }).allowed).toBe(true);
+    for (const m of ["resources/read", "resources/list", "prompts/get", "logging/setLevel", "completion/complete", "sampling/createMessage", "tools/call/extra"])
+      expect(gateReadOnlyRpc(rpc(m)).allowed, m).toBe(false);
+    for (const t of ["send_email", "create_person", "SEND_EMAIL", "get_person ", "get_person\u0000", "*", ""])
+      expect(gateReadOnlyRpc(rpc("tools/call", { name: t })).allowed, JSON.stringify(t)).toBe(false);
+    expect(gateReadOnlyRpc(rpc("tools/call", {})).allowed).toBe(false);
+    expect(gateReadOnlyRpc([]).allowed).toBe(false);
+    expect(gateReadOnlyRpc("x").allowed).toBe(false);
+    expect(gateReadOnlyRpc({ jsonrpc: "2.0", id: 1, result: {} }).allowed).toBe(false);
+  });
+  it("a batch with one forbidden call is refused as a whole (no smuggling after an allowed call)", () => {
+    expect(gateReadOnlyRpc([rpc("tools/call", { name: "get_person" }, 1), rpc("tools/call", { name: "send_email" }, 2)]).allowed).toBe(false);
+  });
+});

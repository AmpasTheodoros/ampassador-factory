@@ -0,0 +1,28 @@
+/**
+ * Audit trail for refused MCP requests.
+ *
+ * Writes one structured JSON line per denial (Vercel keeps these in the function logs). It records WHO was refused
+ * (credential id, never the credential), WHAT was attempted (tool/method name, never arguments) and WHY.
+ * Replace the sink with a database writer if denials must outlive log retention.
+ */
+export interface McpDenial {
+  reason: "invalid_key" | "revoked_key" | "expired_key" | "tool_not_allowed" | "method_not_allowed" | "bad_request" | "method_not_permitted";
+  scope: "read" | "unknown";
+  keyId?: string;
+  tool?: string;
+  method?: string;
+  ip?: string | null;
+}
+
+type Sink = (line: string) => void;
+let sink: Sink = (line) => console.warn(line);
+
+/** Test seam. */
+export function setMcpAuditSink(next: Sink | null) {
+  sink = next ?? ((line) => console.warn(line));
+}
+
+export function auditMcpDenied(e: McpDenial, request?: Request) {
+  const ip = e.ip ?? request?.headers.get("x-forwarded-for")?.split(",")[0]?.trim() ?? null;
+  sink(JSON.stringify({ level: "warn", event: "mcp.denied", ts: new Date().toISOString(), ...e, ip }));
+}

+describe("end to end through handleMcpHttpRequest (real MCP transport)", () => {
+  it("tools/list with a read-only key returns exactly the five read tools, each readOnlyHint", async () => {
+    const res = await handleMcpHttpRequest(post(KEY, rpc("tools/list", {}, 2)));
+    expect(res.status).toBe(200);
+    const json = await sseJson(res);
+    const tools = json.result.tools as { name: string; annotations?: { readOnlyHint?: boolean } }[];
+    expect(tools.map((t) => t.name).sort()).toEqual([...READ_ONLY_TOOL_ALLOWLIST].sort());
+    expect(tools.every((t) => t.annotations?.readOnlyHint === true)).toBe(true);
+  });
+  it("the SAME request with the full key still lists the whole surface (existing clients unaffected)", async () => {
+    const res = await handleMcpHttpRequest(post(FULL, rpc("tools/list", {}, 2)));
+    const json = await sseJson(res);
+    const names = (json.result.tools as { name: string }[]).map((t) => t.name);
+    expect(names.length).toBeGreaterThan(40);
+    expect(names).toContain("send_email");
+  });
+  it("calling send_email with a read-only key is refused with 403 BEFORE execution, and audited", async () => {
+    const res = await handleMcpHttpRequest(post(KEY, rpc("tools/call", { name: "send_email", arguments: { to: "x@y.z", subject: "s", body: "b" } }, 7)));
+    expect(res.status).toBe(403);
+    expect(await res.json()).toMatchObject({ id: 7, error: { code: -32001 } });
+    expect(audit).toEqual([expect.objectContaining({ event: "mcp.denied", reason: "tool_not_allowed", tool: "send_email", keyId: "ci", scope: "read" })]);
+    expect(JSON.stringify(audit)).not.toContain("x@y.z"); // arguments are never logged
+  });
+  it("resources, GET streams and DELETE are refused for a read-only key", async () => {
+    expect((await handleMcpHttpRequest(post(KEY, rpc("resources/read", { uri: "ui://x" })))).status).toBe(403);
+    expect((await handleMcpHttpRequest(post(KEY, null, "GET"))).status).toBe(405);
+    expect((await handleMcpHttpRequest(post(KEY, null, "DELETE"))).status).toBe(405);
+    expect(audit.map((a) => a.reason)).toEqual(["method_not_allowed", "method_not_permitted", "method_not_permitted"]);
+  });
+  it("malformed bodies are 400, not passed to the server", async () => {
+    const r = new Request("http://localhost/mcp", { method: "POST", headers: { authorization: `Bearer ${KEY}`, "content-type": "application/json", accept: "application/json, text/event-stream" }, body: "{not json" });
+    expect((await handleMcpHttpRequest(r)).status).toBe(400);
+  });
+  it("revoking the key takes effect on the very next request", async () => {
+    expect((await handleMcpHttpRequest(post(KEY, rpc("tools/list", {}, 2)))).status).toBe(200);
+    process.env.MCP_READONLY_REVOKED = "ci";
+    expect((await handleMcpHttpRequest(post(KEY, rpc("tools/list", {}, 3)))).status).toBe(401);
+  });
